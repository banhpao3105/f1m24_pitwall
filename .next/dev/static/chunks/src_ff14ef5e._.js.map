ound lives","wet":"Rain possible ({rain}) — Inter/Wet plans appear once this weekend's allocation data exists.","provenance":"Data sources & assumptions","source":{"allocation":"allocation","track":"track","model":"model","practice":"practice","meta":"meta","baseline":"baseline"}},"whatif":{"title":"What-if","pitShift":"{shift, plural, =0 {original plan} other {{shift} lap(s)}}","baseline":"Original plan — no shift","later":"Pitting {laps} lap(s) later than the original plan","earlier":"Pitting {laps} lap(s) earlier than the original plan","rain":"Simulate rain","plan":"Shifted plan:","infeasible":"Infeasible","clamped":"Hit a tyre-life or minimum-stint limit — the plan was clamped per game rules.","wetPlan":"Wet plan (from allocation):","noWetData":"No wet-tyre (I/W) allocation in the save — no wet plan can be built, no fabricated timings."},"race":{"laps":"laps","completed":"Completed","upcoming":"Upcoming","rain":"Rain","dry":"Dry","lastResult":"Your team's result: P{pos} ({points} pts){dnf}","plan":"Recommended tyre plan","pace":"Pace vs rival","paceValue":"{gap}/lap {dir} than {rival}","paceSlower":"slower","paceFaster":"faster","alreadyDone":"This race is completed — the plan below is for reference.","recs":"Recommendations","noRace":"No race to display.","tabOverview":"Overview","tabsLabel":"Race Weekend tabs"},"sim":{"tab":"Sim","title":"Quali & Race Sim","quali":"Quali sim — predicted grid","race":"Race sim — projected finishing order","samples":"{count} samples","src":{"quali":"quali","grid":"grid","practice":"practice","none":"—"},"paceDeltaHint":"Median fastest-lap delta vs the session best","assumptions":"Assumptions & data sources","noData":"Not enough data to run the sim for this race."},"drivers":{"title":"Drivers — form, duel, tyre preservation","cards":"Driver cards","form":"Form","qualiMed":"Quali median","raceMed":"Race median","stint":"Laps/stint","stintHint":"Median laps per stint — tyre preservation proxy from pit history","dnfRate":"DNF","lap